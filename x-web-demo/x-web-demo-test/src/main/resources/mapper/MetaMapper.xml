<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.earth.mapper.MetaMapper">

    <select id="selectHasFunctionNvl" resultType="java.util.Map">
        select nvl(scale_x, '22') scale_x,scale_y,id
        from meta
    </select>
</mapper>
